# Copy this to .env and fill in your values

# ── CDS API (ERA5) ───────────────────────────────────────────────────
# Register at: https://cds.climate.copernicus.eu
# Your UID and API key from: https://cds.climate.copernicus.eu/user/your-profile
CDS_URL=https://cds.climate.copernicus.eu/api/v2
CDS_KEY=<YOUR_UID>:<YOUR_API_KEY>

# ── AWS (GFS from S3, public bucket — no key needed) ─────────────────
# The GFS S3 bucket is public (no AWS account required)
# AWS_ACCESS_KEY_ID=   # NOT needed for public buckets
# AWS_SECRET_ACCESS_KEY=  # NOT needed

# ── Project ───────────────────────────────────────────────────────────
PROJECT_ROOT=.
LOG_LEVEL=INFO
